---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | AI Comment Moderation"
  description="This page does not exist. Return to the AI comment moderation guide."
  error
>
  <section class="container error-page">
    <span class="eyebrow">404 / missing page</span>
    <h1>Page not found</h1>
    <p>There isn’t a page at this address. Try the guide or the tool reviews.</p>
    <a class="button button-dark" href="/">
      Return to the guide <span aria-hidden="true">↗</span>
    </a>
    <a class="text-link" href="/reviews/">
      Browse the tool reviews
    </a>
  </section>
</BaseLayout>
