---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { reviews, reviewedOn } from '../../data/reviews.mjs';
export function getStaticPaths() {
  return reviews.map((review) => ({ params: { slug: review.slug }, props: { review } }));
}
const { review } = Astro.props;
---

<BaseLayout
  title={`${review.name} Review: YouTube Comment Moderation, Pricing and Limits`}
  description={`My source-based review of ${review.name} for YouTube comment moderation: ${review.tagline} Checked ${reviewedOn}.`}
  path={`/reviews/${review.slug}/`}
>
  <article class="section container">
    <p class="eyebrow">
      <a href="/reviews/">Tool reviews</a>
    </p>
    <h1>{review.name} review</h1>
    <p class="hero-intro">{review.tagline}</p>
    <p class="small quiet">
      Source-based review, checked {reviewedOn}. I did not run this tool on a real channel.
    </p>
    {review.disclosure && <p class="note">{review.disclosure}</p>}

    <h2>At a glance</h2>
    <ul>
      <li>
        <strong>YouTube:</strong> {review.youtube}
      </li>
      <li>
        <strong>How it works:</strong> {review.approach}
      </li>
      <li>
        <strong>Pricing:</strong> {review.pricing}
      </li>
      <li>
        <strong>Best for:</strong> {review.bestFor}
      </li>
    </ul>

    <h2>Where it stops</h2>
    <ul>
      {review.limits.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
    {review.caveat && <p class="small quiet">{review.caveat}</p>}

    <p>
      <a class="text-link" href="/reviews/">
        Back to all tool reviews
      </a>
    </p>
  </article>
</BaseLayout>
