---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { reviews, reviewedOn, reviewMethod } from '../../data/reviews.mjs';
---

<BaseLayout
  title="AI Comment Moderation Tool Reviews: YouTube Support and Limits"
  description={`Source-based reviews of ten AI comment moderation tools, with notes on whether YouTube support is confirmed, pricing and limits. Checked ${reviewedOn}.`}
  path="/reviews/"
  socialImage="/review-social-card.png"
  socialImageAlt="AI Comment Moderation tool reviews: source-based reviews, support and limits"
>
  <section class="section container" id="reviews">
    <p class="eyebrow">Tool reviews</p>
    <h1>My reviews of AI comment moderation tools</h1>
    <p class="hero-intro">
      Ten tools compared, with notes on whether YouTube support is confirmed, what each costs and
      where it stops. Checked {reviewedOn}.
    </p>
    <p class="small quiet">
      These are source-based reviews. I read vendor pages and recent write-ups. I did not run the
      tools on a real channel.
    </p>
  </section>

  <section class="section container" id="tool-list">
    <h2>The ten tools</h2>
    <div class="other-grid">
      {reviews.map((review) => (
        <article class="scenario-card">
          <h3>
            <a href={`/reviews/${review.slug}/`}>{review.name}</a>
          </h3>
          <p>{review.tagline}</p>
          <p class="small">
            <strong>Pricing:</strong> {review.pricing}
          </p>
          <a class="text-link" href={`/reviews/${review.slug}/`}>
            Read the {review.name} review <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-tinted" id="how-i-review">
    <div class="container">
      <h2>How I review</h2>
      <ul>
        {reviewMethod.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
