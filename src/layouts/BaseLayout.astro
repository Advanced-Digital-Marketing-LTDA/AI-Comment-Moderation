---
import '../styles/site.css';
import { canonical, siteConfig } from '../lib/site-config.mjs';
interface Props {
  title: string;
  description: string;
  error?: boolean;
}
const { title, description, error = false } = Astro.props;
const config = siteConfig(process.env);
const url = canonical('/');
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${url}#website`, name: 'AI Comment Moderation', url },
    {
      '@type': 'WebPage',
      '@id': `${url}#webpage`,
      name: title,
      description,
      url,
      inLanguage: 'en',
      isPartOf: { '@id': `${url}#website` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f6f7f2" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={config.release && !error ? 'index,follow' : 'noindex,follow'} />
    {!error && <link rel="canonical" href={url} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!error && <meta property="og:url" content={url} />}
    <meta property="og:image" content={`${config.origin}/social-card.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="AI Comment Moderation: a practical guide to rules, AI and human review"
    />
    <meta name="twitter:card" content="summary_large_image" />
    {!error && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="AI Comment Moderation home">
          <span class="brand-mark" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span>
            AI Comment
            <br />
            <strong>Moderation</strong>
            <small>A practical guide</small>
          </span>
        </a>
        <button
          class="nav-toggle"
          id="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Menu: open navigation"
          hidden
        >
          Menu <span aria-hidden="true">+</span>
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Main navigation">
          <a href="/#try-the-examples">Examples</a>
          <a href="/#choose-a-workflow">Workflows</a>
          <a href="/#native-settings">YouTube options</a>
          <a href="/#questions">Questions</a>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <a class="footer-brand" href="/">
          AICommentModeration.com
        </a>
        <p>My reviews of AI comment moderation tools</p>
        <nav aria-label="Footer">
          <a href="/#sources">Sources</a>
          <a href="/#privacy-and-ownership">Privacy & ownership</a>
          <a href="/#main">Back to top ↑</a>
        </nav>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('#nav-toggle');
      const nav = document.querySelector<HTMLElement>('#site-nav');
      if (button && nav) {
        document.documentElement.classList.add('enhanced');
        button.hidden = false;
        const close = () => {
          nav.classList.remove('is-open');
          button.setAttribute('aria-expanded', 'false');
          button.setAttribute('aria-label', 'Menu: open navigation');
        };
        button.addEventListener('click', () => {
          const open = !nav.classList.contains('is-open');
          nav.classList.toggle('is-open', open);
          button.setAttribute('aria-expanded', String(open));
          button.setAttribute(
            'aria-label',
            open ? 'Menu: close navigation' : 'Menu: open navigation',
          );
        });
        nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && nav.classList.contains('is-open')) {
            close();
            button.focus();
          }
        });
        matchMedia('(min-width: 761px)').addEventListener('change', close);
      }
    </script>
  </body>
</html>
